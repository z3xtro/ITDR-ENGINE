<!-- Add inside <ossec_config> in /var/ossec/etc/ossec.conf on the
     MANAGER, then: systemctl restart wazuh-manager
     (docker: docker compose restart wazuh.manager)

     hook_url : the ITDR engine's WazuhListener endpoint
     api_key  : must equal the engine's WAZUH_SHARED_TOKEN
     group    : only auth-taxonomy alerts leave the manager — the
                engine re-filters anyway, but don't ship noise. -->
<integration>
  <name>custom-itdr</name>
  <hook_url>http://ITDR_ENGINE_HOST:8099/wazuh</hook_url>
  <api_key>CHANGE_ME_SHARED_TOKEN</api_key>
  <group>authentication_success,authentication_failed,authentication_failures,invalid_login</group>
  <alert_format>json</alert_format>
</integration>
