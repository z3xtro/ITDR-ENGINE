# Copy to /etc/itdr-console.env and chmod 600 — this holds credentials.
#
# Only the Indexer variables are required. The manager API is needed
# just for agent inventory and Active Response containment.

WAZUH_INDEXER_URL=https://localhost:9200
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASSWORD=CHANGE_ME

# Optional — enables containment and agent inventory.
#WAZUH_API_URL=https://localhost:55000
#WAZUH_API_USER=wazuh-wui
#WAZUH_API_PASSWORD=CHANGE_ME

# Stock Wazuh ships a self-signed certificate. Set to a CA bundle path
# once you have one; leaving this false makes the connection
# interceptable on the local network.
WAZUH_VERIFY_TLS=false

# Keep the console's polling cursor separate from the service's, or the
# two consume each other's events and each sees half the traffic.
WAZUH_CURSOR_FILE=/home/wazuh-user/ITDR-ENGINE/.wazuh_console_cursor.json
