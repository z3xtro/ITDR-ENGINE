# Always-on ITDR console.
#
#   sudo cp deploy/systemd/itdr-console.service /etc/systemd/system/
#   sudo cp deploy/systemd/itdr-console.env /etc/itdr-console.env
#   sudo chmod 600 /etc/itdr-console.env        # it holds credentials
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now itdr-console
#
#   systemctl status itdr-console
#   journalctl -u itdr-console -f
#
# Deliberately minimal. An earlier version carried ProtectSystem=strict,
# PrivateTmp and friends; on this OVA that produced
# "Result: resources" — systemd failing to build the namespace before it
# ever ran the command, with no useful error. A dashboard that refuses
# to start is worth less than one running without sandboxing, so the
# hardening is gone. Add it back a directive at a time if you want it,
# checking `systemctl start` after each.
#
# ExecStart uses /usr/bin/env so it finds python3.11 wherever the distro
# put it, rather than hardcoding a path that varies.

[Unit]
Description=ITDR Console — identity threat detection dashboard
Documentation=https://github.com/z3xtro/ITDR-ENGINE
# Wants= rather than Requires=: the console must still come up and show
# its last state if the indexer is down, since that is precisely when
# someone wants to look at it.
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=wazuh-user
WorkingDirectory=/home/wazuh-user/ITDR-ENGINE

# Dependencies were installed with `pip install --user`, which puts them
# in ~/.local/lib/python3.11/site-packages. Python only adds that path
# when it can resolve the user's home, and a systemd service does not
# reliably inherit HOME — so an interactive run works and the service
# dies with ModuleNotFoundError. Set both: HOME for site.USER_SITE, and
# PYTHONPATH so it works even if HOME is overridden.
Environment=HOME=/home/wazuh-user
Environment=PYTHONPATH=/home/wazuh-user/.local/lib/python3.11/site-packages
Environment=PYTHONUNBUFFERED=1
# The leading '-' makes a missing file non-fatal. Without it, systemd
# refuses to start the unit and logs NOTHING to the unit journal — you
# get "Result: resources" and `journalctl -u` shows "No entries", which
# is close to undiagnosable. With it, the service starts and Python
# exits with a readable message naming the variable it needs.
-EnvironmentFile=/etc/itdr-console.env
ExecStart=/usr/bin/env python3.11 -m itdr.dashboard --live --hours 24 --interval 60 --port 8080

Restart=always
RestartSec=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=itdr-console

[Install]
WantedBy=multi-user.target
